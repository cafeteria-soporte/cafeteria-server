# =============================================================================
# .env.example — Plantilla de variables de entorno
# =============================================================================
# Copia este archivo a .env y completa los valores reales.
#   cp .env.example .env
#
# NUNCA commitees el .env real al repositorio.
# Este archivo (.env.example) SÍ se commitea — es la documentación de las vars.
# =============================================================================


# ── Servidor ──────────────────────────────────────────────────────────────────

# Ambiente de ejecución: development | production | test | debug
NODE_ENV=development

# Puerto en el que escucha la app
PORT=3000

# Prefijo global de todas las rutas  →  /api/...
API_PREFIX=api

# Orígenes permitidos por CORS.
# Usar * para permitir cualquier origen (solo en desarrollo).
# En producción: https://mifrontend.com  o  https://a.com,https://b.com
DOMAIN_FRONTEND=*


# ── Base de datos ─────────────────────────────────────────────────────────────

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=my_app_db

# Muestra las queries SQL en consola (solo útil en desarrollo)
DB_LOGS=false


# ── JWT ───────────────────────────────────────────────────────────────────────

# En producción siempre es true, sin importar este valor
ACTIVE_JWT=true

# Firmado con JWT_SECRET. Viaja en cada request (Authorization: Bearer <token>).
# Genera un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# Tiempo de expiración del accessToken: 60s | 1h | 8h | 24h
# Sin refresh tokens — usa una vida más larga que sea práctica para el turno de trabajo.
JWT_TIME_EXPIRE=8h


# ── Seed ─────────────────────────────────────────────────────────────────────
# Datos del usuario root que se crea al correr: npm run seed
# IMPORTANTE: cambia estos valores antes de correr el seed en producción.
# Si no se definen, el seed usa los valores por defecto (solo válidos en desarrollo).
SEED_ROOT_USERNAME=root
SEED_ROOT_PASSWORD=root1234


# ── Plugin: mailer ────────────────────────────────────────────────────────────
# Eliminar esta sección si no usas plugins/mailer/

# Transporte de email: smtp | api
MAILER_TRANSPORT=smtp

# --- Transporte SMTP (MAILER_TRANSPORT=smtp) ----------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM="Mi App" <no-reply@miapp.com>

# --- Transporte API (MAILER_TRANSPORT=api) ------------------------------------
# Compatible con Resend por defecto. Para SendGrid u otros: ajusta api.adapter.ts
# MAILER_API_URL=https://api.resend.com/emails
# MAILER_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAILER_FROM="Mi App" <no-reply@miapp.com>


# ── Plugin: socket ────────────────────────────────────────────────────────────
# Eliminar esta sección si no usas plugins/socket/

# Namespace del WebSocket gateway
WEBSOCKET_NAMESPACE=app
